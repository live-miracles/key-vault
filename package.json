{
    "name": "key-vault",
    "version": "4.0.4",
    "description": "Key Vault: manage event stream keys with role-based access, on Supabase and Vercel.",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node build-tools/dev.mjs",
        "css": "tailwindcss -i ./frontend/input.css -o ./frontend/output.css",
        "pages": "node build-tools/pages.mjs",
        "build:vercel": "npm run css && node build-tools/vercel.mjs",
        "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p supabase/functions/_shared/tsconfig.json",
        "test": "node test/run-tests.mjs",
        "test:db": "node test/migrations-db-check.mjs",
        "sheet:sql": "node build-tools/sheet-to-sql.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.1",
        "@tailwindcss/typography": "^0.5.19",
        "concurrently": "^9.2.1",
        "esbuild": "^0.28.2",
        "execa": "^9.6.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "supabase": "^2.122.1",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.119.0"
    }
}

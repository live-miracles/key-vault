{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "strict": false,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts"]
}
